# ==============================================
# Keuangan Personal - Konfigurasi Environment
# ==============================================

# ---- Server ----
NODE_ENV=production
PORT=3000
API_PORT=3001

# ---- Database PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=keuangan_personal
DB_USER=postgres
DB_PASSWORD=postgres

# ---- JWT Secret (ganti dengan string random yang kuat) ----
JWT_SECRET=ganti-dengan-secret-key-yang-kuat-dan-panjang

# ---- CORS (kosongkan untuk allow all) ----
# CORS_ORIGIN=https://keuangan99.com

# ---- Catatan Docker ----
# Saat menggunakan docker-compose, DB_HOST harus diisi nama service postgres:
# DB_HOST=postgres
